# Ramp Developer API app (Client Credentials). Create in Ramp as an admin:
# Settings > Developer API > Create app. Enable these scopes on the app:
#   transactions:read users:read funds:read departments:read entities:read
#   accounting:read accounting:write
RAMP_CLIENT_ID=your_client_id_here
RAMP_CLIENT_SECRET=your_client_secret_here
# demo or production
RAMP_ENVIRONMENT=demo
# Optional: override the requested scopes (space separated)
# RAMP_SCOPES=

# ramp_id of the NetSuite Department accounting field. Find it with:
#   python -m scripts.discover_fields
# If blank, the field is looked up by NETSUITE_DEPARTMENT_FIELD_NAME instead.
NETSUITE_DEPARTMENT_TRACKING_CATEGORY_ID=your_department_tracking_category_uuid
NETSUITE_DEPARTMENT_FIELD_NAME=Department

# Optional JSON file: Ramp department (id or name) -> NetSuite department option
# (ramp_id, NetSuite internal id, or name). null = never auto-code that department.
# See department_map.example.json.
DEPARTMENT_MAP_FILE=

POLL_INTERVAL_MINUTES=15
LOOKBACK_DAYS=30
DRY_RUN=false
LOG_LEVEL=INFO
STATE_DB_PATH=state.db
CACHE_TTL_SECONDS=900
MAX_RETRIES=5

# --- Webhook server only (server/) ---
# Signing secret printed by `python -m scripts.register_webhook <url>`; used to
# verify X-Ramp-Signature. Blank = events are accepted unverified (setup only).
RAMP_WEBHOOK_SECRET=
# Local dev only - Render injects its own PORT.
PORT=8000
